[Unit]
Description=LinkedIn Feed Clone - Daily Winners
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/home/appuser/twitter_influencer
Environment=PATH=/home/appuser/.local/bin:/usr/bin:/usr/local/bin
Environment=HOME=/home/appuser
Environment=CHAT_BACKEND=llama_cpp
Environment=CHAT_LLAMA_MODEL=LiquidAI/LFM2-2.6B-GGUF:LFM2-2.6B-Q4_K_M.gguf
Environment=CHAT_LLAMA_CLI=/home/appuser/opt/llama.cpp/llama-cli
Environment=CHAT_MAX_TOKENS=180
Environment=CHAT_LLAMA_THREADS=6
Environment=CHAT_ENABLE_RERANKER=1
Environment=CHAT_CONTEXT_MAX_SOURCES=3
Environment=CHAT_CONTEXT_SOURCE_CHARS=450
ExecStart=/home/appuser/.local/bin/uv run python linkedin_feed.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
